import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read input image
image = cv2.imread(input("Enter image path: "))
image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

# Input filter size
n = int(input("Enter filter size (odd number): "))

# Input padding method
print("1. Zero Padding")
print("2. Replication Padding")
print("3. Reflection Padding")

choice = int(input("Enter padding choice: "))

pad = n // 2

# Apply padding
if choice == 1:
    padded = np.pad(image, ((pad,pad),(pad,pad),(0,0)),
                    mode='constant')
elif choice == 2:
    padded = np.pad(image, ((pad,pad),(pad,pad),(0,0)),
                    mode='edge')
elif choice == 3:
    padded = np.pad(image, ((pad,pad),(pad,pad),(0,0)),
                    mode='reflect')
else:
    print("Invalid choice")
    exit()

# Create weighted kernel
kernel = np.zeros((n,n))

for i in range(n):
    for j in range(n):
        x = i - pad
        y = j - pad
        kernel[i,j] = max(abs(x), abs(y))

# Normalize kernel
if np.sum(kernel) == 0:
    print("Invalid filter size")
    exit()

kernel = kernel / np.sum(kernel)

# Apply filter
output = np.zeros_like(image)

for i in range(image.shape[0]):
    for j in range(image.shape[1]):
        for c in range(3):
            region = padded[i:i+n, j:j+n, c]
            output[i,j,c] = np.sum(region * kernel)

# Display images
plt.figure(figsize=(10,5))

plt.subplot(1,2,1)
plt.imshow(image)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1,2,2)
plt.imshow(output)
plt.title("Weighted Filter")
plt.axis("off")

plt.show()

cv2.imwrite("weighted_output.png",
            cv2.cvtColor(output, cv2.COLOR_RGB2BGR))
