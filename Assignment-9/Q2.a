import cv2
import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import wiener

# Read image
image = cv2.imread(input("Enter image path: "),
                   cv2.IMREAD_GRAYSCALE)

if image is None:
    print("Image not found!")
    exit()

image = image.astype(np.float64)

# Generate Gaussian noise
gaussian_noise = np.random.normal(0, 20, image.shape)
gaussian_noisy = image + gaussian_noise

# Generate Speckle noise
speckle_noise = np.random.normal(0, 0.2, image.shape)
speckle_noisy = image + image * speckle_noise

# Clip images
gaussian_noisy = np.clip(gaussian_noisy, 0, 255)
speckle_noisy = np.clip(speckle_noisy, 0, 255)

# Input window size
size = int(input("Enter window size (3 or 5): "))

# Apply Wiener filter
gaussian_denoised = wiener(gaussian_noisy, (size, size))
speckle_denoised = wiener(speckle_noisy, (size, size))

# Display results
plt.figure(figsize=(12, 8))

images = [
    image,
    gaussian_noisy,
    gaussian_denoised,
    speckle_noisy,
    speckle_denoised
]

titles = [
    "Original Image",
    "Gaussian Noisy",
    "Gaussian Wiener",
    "Speckle Noisy",
    "Speckle Wiener"
]

for i in range(5):
    plt.subplot(2, 3, i+1)
    plt.imshow(images[i], cmap='gray', vmin=0, vmax=255)
    plt.title(titles[i])
    plt.axis("off")

plt.tight_layout()
plt.show()
