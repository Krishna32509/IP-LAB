import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read input image
image = cv2.imread(input("Enter image path: "),
                   cv2.IMREAD_GRAYSCALE)

if image is None:
    print("Image not found!")
    exit()

image = image.astype(np.float64)

# Input parameters
mean = float(input("Enter mean: "))
sigma = float(input("Enter standard deviation: "))

# Generate Gaussian noise using PDF
noise = np.random.normal(mean, sigma, image.shape)

# Add noise to image
noisy_image = image + noise
noisy_image = np.clip(noisy_image, 0, 255).astype(np.uint8)

# Display results
plt.figure(figsize=(12,5))

plt.subplot(1,3,1)
plt.imshow(image, cmap='gray')
plt.title("Original Image")
plt.axis("off")

plt.subplot(1,3,2)
plt.imshow(noisy_image, cmap='gray')
plt.title("Gaussian Noise Image")
plt.axis("off")

plt.subplot(1,3,3)
plt.hist(noise.flatten(), bins=50, density=True)
plt.title("Gaussian Noise Histogram")

plt.tight_layout()
plt.show()

cv2.imwrite("gaussian_noise.png", noisy_image)
