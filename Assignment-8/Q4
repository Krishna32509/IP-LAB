import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read input image
image = cv2.imread(input("Enter image path: "),
                   cv2.IMREAD_GRAYSCALE)

if image is None:
    print("Image not found!")
    exit()

image = image.astype(np.float64)

# Input parameter
a = float(input("Enter rate parameter (a): "))

if a <= 0:
    print("Rate parameter must be positive!")
    exit()

# Generate exponential noise using PDF
noise = np.random.exponential(1/a, image.shape)

# Add noise to image
noisy_image = image + noise
noisy_image = np.clip(noisy_image, 0, 255).astype(np.uint8)

# Display results
plt.figure(figsize=(12,5))

plt.subplot(1,3,1)
plt.imshow(image, cmap='gray')
plt.title("Original Image")
plt.axis("off")

plt.subplot(1,3,2)
plt.imshow(noisy_image, cmap='gray')
plt.title("Exponential Noise Image")
plt.axis("off")

plt.subplot(1,3,3)
plt.hist(noise.flatten(), bins=50, density=True)
plt.title("Exponential Noise Histogram")

plt.tight_layout()
plt.show()

cv2.imwrite("exponential_noise.png", noisy_image)
